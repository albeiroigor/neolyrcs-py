$bg-dark: #000000;
$text-light: #f5f5f7;
$text-dim: #2f94d8;

/* ---------------------------------------------------------------- */
/* Pantalla principal (ui.py: LyricsApp)                             */
/* ---------------------------------------------------------------- */

Screen {
    background: $bg-dark;
    align: center middle;
}

#box {
width: 90%;
height: 90%;
max-width: 80;
min-width: 34;
max-height: 22;
min-height: 12;
padding: 1 2;
background: $bg-dark;
border: round #ffffff;
}

#song_info {
height: 3;
content-align: center middle;
text-style: bold;
color: $text-light;
padding: 0 1;
margin-bottom: 1;
}

#lyrics {
height: 1fr;
overflow-y: auto;
content-align: center middle;
color: $text-dim;
padding: 1 0;
text-align: center;
}

#progress {
width: 100%;
height: 1;
margin-top: 1;
}

#progress Bar {
width: 1fr;
}

#progress Bar > .bar--bar {
color: #939292;
background: $surface;
}

#progress Bar > .bar--complete {
color: #f3f3f3;
}

ScrollBar {
    background: transparent;
    width: 1;
}

/* ---------------------------------------------------------------- */
/* Modales (windows.py: ConfigScreen y ManualLyricsScreen)           */
/* ---------------------------------------------------------------- */

ConfigScreen {
    align: center middle;
}

.modal_box {
    width: 90%;
    height: 90%;
    max-width: 80;
    min-width: 34;
    max-height: 22;
    min-height: 12;
    padding: 1 2;
    background: $bg-dark;
    border: round #ffffff;
}

.modal_box > Static {
    height: 1;
    margin-top: 1;
    text-style: bold;
    color: $text-light;
}

.modal_box > Static:first-child {
    margin-top: 0;
}
.modal_box Input {
    margin-top: 1;
}

Select {
    width: 100%;
    margin-bottom: 1;
}

/* Usado por el hint de LyricsApp y por el de ambos modales. Es el mismo
 *   id repetido en pantallas distintas: funciona porque nunca hay dos
 *   pantallas montadas al mismo tiempo, pero si en el futuro se vuelve
 *   confuso, lo mas prolijo seria pasarlo a una clase ".hint". */
#hint {
color: $text-dim;
text-style: italic;
}
